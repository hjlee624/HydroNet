# Sequence 서버 환경설정 (ADR-002). 실제 값은 .env(git 미추적)에.
# 이 파일을 server/.env 로 복사해 값을 채우면 npm start/dev 가 자동 로드(--env-file-if-exists=.env).
PORT=4020
HOST=0.0.0.0

# 인증 게이트: 1=활성(기본), 0=비활성(무인증 — 개발 전용)
AUTH_ENABLED=1
# 저장소 백엔드: memory(JSON 파일, dev/오프라인) | pg(PostgreSQL, 운영)
AUTH_BACKEND=memory
# AUTH_BACKEND=pg 일 때:
# DATABASE_URL=postgres://user:pass@localhost:5432/sequence   # 스키마: server/db/schema.sql

# 세션 JWT 서명 비밀키(운영 필수, 16자 이상). 미설정 시 재시작마다 세션 무효(dev 편의).
# AUTH_JWT_SECRET=please-change-to-a-long-random-secret

# 최초 부트스트랩 개발자 계정(사용자 0명일 때 1회 생성). 이후 엑셀 업로드로 계정 관리.
AUTH_BOOTSTRAP_USER=admin
AUTH_BOOTSTRAP_PASSWORD=sequence

# 쿠키 Secure(운영/HTTPS=1). 내부 TLS(자체서명 CA) 필요 — ADR-001.
# AUTH_SECURE_COOKIE=1

# ── 실시간 AI 공기 검토 프록시(검토서 Part A) — BYO 키 ──
# [AI 검토] 다이얼로그의 "앱에서 바로 검토"가 서버를 통해 아래 키로 LLM을 호출한다.
# 키가 설정된 공급자만 활성화되며, 미설정 공급자는 사용자에게 명확히 안내된다(조용한 실패 없음).
# 파일 왕복(.md export→붙여넣기→import) 방식은 키가 없어도 항상 병존한다(폐쇄망·오프라인).
# ANTHROPIC_API_KEY=sk-ant-...          # Claude(권장). 공식 SDK로 호출.
# OPENAI_API_KEY=sk-...                 # OpenAI(GPT). REST 호출.
# GEMINI_API_KEY=...                    # Google Gemini(= GOOGLE_API_KEY 도 인식). REST 호출.
# 모델 override(선택) — 기본: claude-opus-4-8 / gpt-4o / gemini-1.5-pro
# LLM_ANTHROPIC_MODEL=claude-opus-4-8
# LLM_OPENAI_MODEL=gpt-4o
# LLM_GEMINI_MODEL=gemini-1.5-pro
# LLM_MAX_TOKENS=8000                   # 회신 최대 토큰(기본 8000)

# ── 네이버웍스(NAVER WORKS) Bot 알림 — 운영자(개발자) 본인에게만 DM ──
# 알림 이벤트: 계정 등록(사용자·PM) · 프로젝트 생성 · 프로젝트 삭제 · 비밀번호 초기화 요청.
# 아래 6개가 모두 설정돼야 발송(하나라도 비면 조용히 무시 — 앱 흐름엔 영향 없음).
# Developer Console(developers.worksmobile.com)에서 앱·서비스계정·봇 등록 후 발급:
# WORKS_CLIENT_ID=
# WORKS_CLIENT_SECRET=
# WORKS_SERVICE_ACCOUNT=xxxx@yourdomain    # 서비스 계정(이메일 형식)
# WORKS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"  # PKCS8, 개행은 \n
# WORKS_BOT_ID=                            # 등록한 Bot ID
# WORKS_NOTIFY_USER_ID=                    # 수신자=운영자 본인의 네이버웍스 사용자 ID(이메일, 예: hjlee@samaneng.com)
# WORKS_SCOPE=bot                          # 선택(기본 bot). bot.message 로도 가능
# WORKS_APP_URL=https://...                # 선택 — 알림 하단에 붙일 앱(관리자 도구) 링크
