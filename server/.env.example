# Sequence 서버 환경설정 (ADR-002). 실제 값은 .env(git 미추적)에.
PORT=4020
HOST=0.0.0.0

# 인증 게이트: 1=활성(기본), 0=비활성(무인증 — 개발 전용)
AUTH_ENABLED=1
# 저장소 백엔드: memory(JSON 파일, dev/오프라인) | pg(PostgreSQL, 운영)
AUTH_BACKEND=memory
# AUTH_BACKEND=pg 일 때:
# DATABASE_URL=postgres://user:pass@localhost:5432/sequence   # 스키마: server/db/schema.sql

# 세션 JWT 서명 비밀키(운영 필수, 16자 이상). 미설정 시 재시작마다 세션 무효(dev 편의).
# AUTH_JWT_SECRET=please-change-to-a-long-random-secret

# 최초 부트스트랩 개발자 계정(사용자 0명일 때 1회 생성). 이후 엑셀 업로드로 계정 관리.
AUTH_BOOTSTRAP_USER=admin
AUTH_BOOTSTRAP_PASSWORD=sequence

# 쿠키 Secure(운영/HTTPS=1). 내부 TLS(자체서명 CA) 필요 — ADR-001.
# AUTH_SECURE_COOKIE=1

# ── 관리자(PM) 등록 SMS 알림(개발자 로그인 불필요) ──
# 미설정(log)이면 실제 발송 없이 서버 로그에만 기록. 운영은 aligo 또는 webhook 선택.
SMS_PROVIDER=log
# 수신 개발자 번호(쉼표로 여러 명). 비우면 전화번호 ID를 가진 활성 개발자에게 자동 발송.
# NOTIFY_PHONE=010-1234-5678
# 발신번호(게이트웨이에 사전 등록된 번호)
# SMS_SENDER=0212345678
# aligo(알리고) 사용 시:
# SMS_PROVIDER=aligo
# SMS_API_KEY=발급키
# SMS_USER_ID=알리고아이디
# SMS_TEST=1              # 테스트모드(실발송/과금 없음)
# 임의 게이트웨이/프록시(webhook) 사용 시: POST JSON {to, from, text}
# SMS_PROVIDER=webhook
# SMS_WEBHOOK_URL=https://your-sms-gateway.example/send
