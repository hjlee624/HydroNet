# Dependencies
node_modules/
*/node_modules/

# Build output
dist/
build/
*/dist/
dist-single/
**/dist-single/
*.tsbuildinfo

# Single-file build: bundled KoPub OTFs (large binaries, not committed).
client/public/fonts/*.otf
# 정식 배포본 HydroNet.html 은 저장소에 포함(다운로드 배포용). 날짜 스냅샷만 무시.
/HydroNet_*.html

# 과거 백업 스냅샷(개인 로컬 보관용) — VCS에 올리지 않음. 2026-07-30 추적 해제.
@bak/

# Logs (ABS_RULE: program logs live in error.log; keep them local, not in VCS)
error.log
*.log
logs/

# Runtime project data (file-based storage)
server/data/*.json
!server/data/.gitkeep

# Environment / editor / tooling
.env
.env.local
.DS_Store
.vscode/
.idea/
.omc/
.claude/

# Electron packaging output (future)
out/
release/
*.exe

# Dev render / verification artifacts
preview.png
preview.svg
**/preview.png
**/preview.svg
sample.dxf
**/sample.dxf

# Exported drawings / reference images dropped in the repo root (DESIGN/ assets
# are kept; only root-level artifacts are ignored via the leading slash).
/*.png
/*.svg
/*.jpg
/*.jpeg
/*.dxf
/*.pdf

# Video assets — 데모 영상 제거(2026-07-30). 루트 레벨 동영상은 무시(개인 자료 방지).
/*.mp4
/*.mov
/*.avi
/*.mkv
